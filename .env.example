# === Режим работы ===
# lite  — всё в одном процессе: SQLite + fakeredis + in-memory векторный индекс + mock-LLM (демо без Docker)
# full  — PostgreSQL + Redis + Qdrant + TEI (docker compose)
APP_MODE=full

# === Базовые ===
# Обязательны в режиме full: без них compose откажется подниматься, а сервис
# остановится на старте. start.sh и start.ps1 заполняют их случайными
# значениями при первом запуске.
APP_SECRET=
DATA_DIR=/data
# Учётные данные сотрудников, заводимые сидером при первом старте
ADMIN_PASSWORD=
OPERATOR_PASSWORD=
# Пароль базы: подставляется и в DATABASE_URL, и в сам контейнер postgres
POSTGRES_PASSWORD=

# === Хранилища (full) ===
# Собирается из POSTGRES_PASSWORD в docker-compose.yml; здесь — для запуска
# бэкенда вне compose.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
TEI_URL=http://tei:80
# Apple Silicon / ARM64: ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-latest
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
# cross-encoder реранкер (профиль rerank, включается тумблером retrieval.use_reranker в админке)
TEI_RERANK_URL=http://tei-rerank:80
RERANK_MODEL=DiTy/cross-encoder-russian-msmarco
# нейросеть против оскорблений (сервис tei-toxicity в базовом стеке); пусто — только правила и словарь
TOXICITY_URL=http://tei-toxicity:80

# === LLM (OpenAI-совместимый API; пусто = встроенный mock-режим) ===
# Модель — qwen3.8:27b в Ollama. Сейчас она крутится на отдельном GPU-сервере:
# LLM_BASE_URL — его адрес вида http://<хост>:<порт>/v1, LLM_API_KEY — его ключ.
# Своя Ollama на этой машине — только по флагу COMPOSE_PROFILES=ollama (без него модель
# не скачивается); тогда LLM_BASE_URL=http://ollama:11434/v1 и LLM_API_KEY=ollama.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.8:27b
# Профиль ollama: какую модель скачать и сколько контекста держать (на GPU 32 ГБ влезает 262144)
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_CONTEXT_LENGTH=32768

# === Голосовой ввод (локальный STT-микросервис, профиль voice) ===
STT_URL=http://stt:9000

# === Разбор PDF с картинками (docling, профиль docs) ===
# Пусто — методички разбираются markitdown'ом: текст тот же, иллюстраций нет.
DOCPARSE_URL=http://docparse:9100

# === Хранилище иллюстраций базы знаний ===
# Пусто — файлы в томе данных (этого достаточно, пока инстансы API делят один том).
# Задан endpoint — любое S3-совместимое хранилище; профиль s3 поднимает MinIO рядом.
S3_ENDPOINT=
S3_ACCESS_KEY=valerchik
S3_SECRET_KEY=valerchik-secret
S3_BUCKET=valerchik-kb

# === Каталог товаров портала (MCP-сервер, поднимается в базовом стеке) ===
# Адрес, под которым сервер каталога сам пропишется в реестр MCP при старте API.
# Пусто — не регистрировать: инструменты поиска товаров агенту не достанутся.
ZAKUPKI_MCP_URL=http://zakupki-mcp:9200/mcp
# Свой лимит обращений к чужому порталу: у него собственного нет, это наша дисциплина.
ZAKUPKI_RPS=2.0
# Сторона бокса превью товара в пикселях.
ZAKUPKI_THUMB_SIZE=300

# === Образы (нужны только на сервере) ===
# Откуда `docker compose pull` берёт собранные образы. Локально ничего задавать
# не нужно: `up --build` собирает их сам и метит теми же именами.
# IMAGE_TAG=v1.0.0 откатывает стенд на конкретный релиз вместо latest.
IMAGE_PREFIX=ghcr.io/mojarung/tender_hack_nijniy_2026
IMAGE_TAG=latest

# === Наблюдаемость ===
LOG_LEVEL=INFO

# === Сид-данные для демо (создаются при первом старте) ===
# Пароли сотрудников задаются выше, в разделе «Базовые»: здесь их дубль означал
# бы, что известные значения возвращаются в стенд через нижнюю строку файла.
SEED_ON_STARTUP=true

# === Браузерные ограничения ===
# Через запятую: origin-ы, которым разрешён доступ к API из браузера.
# Пусто — только свой origin (расширение проходит по отдельному правилу).
ALLOWED_ORIGINS=
# Подсеть сети compose: только от её адресов API верит X-Forwarded-For (адрес
# клиента за nginx). Менять, если на хосте она уже занята другой сетью.
COMPOSE_SUBNET=172.31.240.0/24

# /metrics в боевом режиме: пусто — ручки нет (404), задан — только с заголовком
# Authorization: Bearer <токен>. Наружу nginx её не проксирует.
METRICS_TOKEN=
# Swagger (/api/docs) в боевом режиме выключен; true — включить на стенде.
API_DOCS=false
