<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="https://tenderhack.ru/valerchik">
  <bpmn:collaboration id="Collab_Support">
    <bpmn:participant id="Participant_Support" name="Обработка обращения в службу поддержки Портала поставщиков" processRef="Process_Support" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Support" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Support">
      <bpmn:lane id="Lane_0" name="Пользователь">
        <bpmn:flowNodeRef>StartQuestion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RateAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndAuto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfirmSolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndOperator</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Валерчик (ИИ-агент)">
        <bpmn:flowNodeRef>CheckAbuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwAbuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyAbuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndAbuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Normalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SearchKb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwConfidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordGap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OfferOperator</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwAmbiguous</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AskClarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwHelped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enqueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Оператор поддержки">
        <bpmn:flowNodeRef>TakeCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AcceptTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Requeue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Copilot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OperatorReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ProposeSolution</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartQuestion" name="Пользователь задал вопрос"><bpmn:documentation>Веб-чат, встроенный виджет на стороннем сайте или страница /widget.</bpmn:documentation><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="CheckAbuse" name="Проверить сообщение на нецензурную лексику"><bpmn:documentation>Нормализация обфускаций: гомоглифы, разделители, латиница, цензура звёздочками.</bpmn:documentation><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GwAbuse" name="Нарушение правил общения?"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="NotifyAbuse" name="Уведомить о нарушении и завершить обращение"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndAbuse" name="Обращение закрыто по правилам общения"><bpmn:incoming>Flow_3</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Normalize" name="Восстановить раскладку, учесть раздел портала"><bpmn:documentation>«Rfr pfhtubcnhbhjdfnmcz» → «Как зарегистрироваться». Раздел портала приходит от виджета и влияет на ранжирование.</bpmn:documentation><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="SearchKb" name="Найти ответ в базе знаний: вектор + BM25 + RRF"><bpmn:documentation>Гибридный поиск: BERTA через TEI в Qdrant, лексический BM25, слияние Reciprocal Rank Fusion, опционально cross-encoder реранкер.</bpmn:documentation><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GwConfidence" name="Уверенность выше порога?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="RecordGap" name="Зафиксировать вопрос как пробел базы знаний"><bpmn:documentation>Повторы группируются: пробел с частотой одним кликом становится статьёй.</bpmn:documentation><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="OfferOperator" name="Сообщить, что ответа нет, и предложить оператора"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GwAmbiguous" name="Тема определяется однозначно?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="AskClarify" name="Задать уточняющий вопрос"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Answer" name="Ответить с источниками и уверенностью"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="RateAnswer" name="Оценить ответ"><bpmn:documentation>Палец вверх/вниз в чате и оценка 1–5 при закрытии обращения.</bpmn:documentation><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GwHelped" name="Ответ помог?"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndAuto" name="Решено без оператора"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Classify" name="Определить линию поддержки"><bpmn:documentation>Softmax-регрессия на эмбеддингах, дообучается на статьях и реальных эскалациях.</bpmn:documentation><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Enqueue" name="Поставить обращение в очередь линии"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Assign" name="Назначить свободному сотруднику с минимальной нагрузкой"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:task>
    <bpmn:task id="TakeCase" name="Принять назначение"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:task>
    <bpmn:boundaryEvent id="AcceptTimeout" name="60 секунд" attachedToRef="TakeCase"><bpmn:outgoing>Flow_21</bpmn:outgoing><bpmn:timerEventDefinition id="Timer_AcceptTimeout" /></bpmn:boundaryEvent>
    <bpmn:task id="Requeue" name="Вернуть в очередь без сброса времени ожидания"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Copilot" name="Сводка, проверки, источники и черновик"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:task>
    <bpmn:task id="OperatorReply" name="Ответить или запросить сведения"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:task>
    <bpmn:task id="ProposeSolution" name="Предложить решение"><bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_26</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="ConfirmSolution" name="Пользователь подтвердил решение?"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing><bpmn:outgoing>Flow_28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndOperator" name="Решение подтверждено"><bpmn:incoming>Flow_27</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartQuestion" targetRef="CheckAbuse" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="CheckAbuse" targetRef="GwAbuse" />
    <bpmn:sequenceFlow id="Flow_2" name="да" sourceRef="GwAbuse" targetRef="NotifyAbuse" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="NotifyAbuse" targetRef="EndAbuse" />
    <bpmn:sequenceFlow id="Flow_4" name="нет" sourceRef="GwAbuse" targetRef="Normalize" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Normalize" targetRef="SearchKb" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="SearchKb" targetRef="GwConfidence" />
    <bpmn:sequenceFlow id="Flow_7" name="нет" sourceRef="GwConfidence" targetRef="RecordGap" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="RecordGap" targetRef="OfferOperator" />
    <bpmn:sequenceFlow id="Flow_9" name="да" sourceRef="GwConfidence" targetRef="GwAmbiguous" />
    <bpmn:sequenceFlow id="Flow_10" name="нет" sourceRef="GwAmbiguous" targetRef="AskClarify" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="AskClarify" targetRef="SearchKb" />
    <bpmn:sequenceFlow id="Flow_12" name="да" sourceRef="GwAmbiguous" targetRef="Answer" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Answer" targetRef="RateAnswer" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="RateAnswer" targetRef="GwHelped" />
    <bpmn:sequenceFlow id="Flow_15" name="да" sourceRef="GwHelped" targetRef="EndAuto" />
    <bpmn:sequenceFlow id="Flow_16" name="нет" sourceRef="GwHelped" targetRef="Classify" />
    <bpmn:sequenceFlow id="Flow_17" name="нужен оператор" sourceRef="OfferOperator" targetRef="Classify" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Classify" targetRef="Enqueue" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Enqueue" targetRef="Assign" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Assign" targetRef="TakeCase" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="AcceptTimeout" targetRef="Requeue" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Requeue" targetRef="Assign" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="TakeCase" targetRef="Copilot" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Copilot" targetRef="OperatorReply" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="OperatorReply" targetRef="ProposeSolution" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="ProposeSolution" targetRef="ConfirmSolution" />
    <bpmn:sequenceFlow id="Flow_27" name="Помогло" sourceRef="ConfirmSolution" targetRef="EndOperator" />
    <bpmn:sequenceFlow id="Flow_28" name="Не решено" sourceRef="ConfirmSolution" targetRef="Copilot" />
  </bpmn:process>
